---
import type { PortfolioContent } from '../data/portfolio';
import SiteHeader from './SiteHeader.astro';
import ClusterDiagram from './ClusterDiagram.astro';

interface Props { content: PortfolioContent }
const { content } = Astro.props;
const alternatePath = content.locale === 'fr' ? '/en/' : '/';
const cvLabel = content.locale === 'fr' ? 'CV de Tom Mendy au format PDF' : 'Tom Mendy’s CV in French, PDF';
---

<SiteHeader locale={content.locale} nav={content.nav} alternatePath={alternatePath} home />

<main id="content">
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">{content.hero.eyebrow}</p>
      <h1>{content.hero.title}</h1>
      <p class="hero-intro">{content.hero.intro}</p>
      <p class="availability"><span aria-hidden="true"></span>{content.hero.availability}</p>
      <div class="button-row">
        <a class="button primary" href="mailto:contact@tom-mendy.com">{content.hero.contact}<span aria-hidden="true">↗</span></a>
        <a class="button secondary" href="/downloads/Tom-Mendy-CV-2027.pdf" download aria-label={cvLabel}>{content.hero.cv}<span aria-hidden="true">↓</span></a>
      </div>
      <div class="social-row">
        <a href="https://github.com/Tom-Mendy" rel="me">GitHub <span aria-hidden="true">↗</span></a>
        <a href="https://linkedin.com/in/tom-mendy" rel="me">LinkedIn <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="hero-visual">
      <div class="visual-label"><span>git push</span><span>reconcile</span><span>running</span></div>
      <ClusterDiagram label={content.hero.diagramLabel} />
    </div>
  </section>

  <section class="metrics-band" aria-label={content.locale === 'fr' ? 'Chiffres clés' : 'Key figures'}>
    <div class="shell metrics-grid">
      {content.metrics.map((metric, index) => (
        <article class="metric">
          <span class="metric-index">0{index + 1}</span>
          <strong>{metric.value}</strong>
          <p>{metric.label}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section shell" id="projects">
    <header class="section-heading">
      <p class="eyebrow">{content.projects.eyebrow}</p>
      <h2>{content.projects.title}</h2>
      <p>{content.projects.intro}</p>
    </header>
    <div class="project-grid">
      {content.projects.items.map((project, index) => (
        <article class:list={['project-card', { featured: index === 0 }]}>
          <div class="project-copy">
            <p class="card-eyebrow">{project.eyebrow}</p>
            <h3>{project.name}</h3>
            <p>{project.description}</p>
            <ul class="tag-list" aria-label="Technologies">
              {project.tags.map(tag => <li>{tag}</li>)}
            </ul>
            <div class="card-links">
              {project.caseStudy && <a class="text-link" href={project.caseStudy}>{content.projects.read}<span aria-hidden="true">→</span></a>}
              {project.repository && <a class="text-link muted" href={project.repository}>{content.projects.source}<span aria-hidden="true">↗</span></a>}
            </div>
          </div>
          {index === 0 && <div class="project-flow" aria-hidden="true"><span>Git</span><i></i><span>Flux</span><i></i><span>Helm</span><i></i><span>K8s</span></div>}
        </article>
      ))}
    </div>
  </section>

  <section class="section section-dark" id="experience">
    <div class="shell experience-layout">
      <header class="section-heading sticky-heading">
        <p class="eyebrow">{content.experience.eyebrow}</p>
        <h2>{content.experience.title}</h2>
      </header>
      <div class="timeline">
        {content.experience.items.map((job, index) => (
          <article class="timeline-item">
            <span class="timeline-number">0{index + 1}</span>
            <div class="timeline-head">
              <div><h3>{job.company}</h3><p>{job.role}</p></div>
              <div class="timeline-meta"><time>{job.period}</time>{job.status && <span>{job.status}</span>}</div>
            </div>
            <ul>{job.bullets.map(bullet => <li>{bullet}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section shell" id="skills">
    <header class="section-heading narrow">
      <p class="eyebrow">{content.skills.eyebrow}</p>
      <h2>{content.skills.title}</h2>
    </header>
    <div class="skills-grid">
      {content.skills.groups.map((group, index) => (
        <article class="skill-group">
          <span>0{index + 1}</span>
          <h3>{group.name}</h3>
          <p>{group.items.join(' · ')}</p>
        </article>
      ))}
    </div>
    <div class="credentials-grid">
      <article class="credential accent-card">
        <p>{content.profile.certificationLabel}</p>
        <h3>{content.profile.certificationTitle}</h3>
        <span>{content.profile.certificationDetail}</span>
        <strong aria-hidden="true">CKAD</strong>
      </article>
      <article class="credential">
        <p>{content.profile.educationLabel}</p>
        <h3>{content.profile.educationTitle}</h3>
        <span>{content.profile.educationDetail}</span>
      </article>
      <article class="credential">
        <p>{content.profile.languageLabel}</p>
        <h3>{content.profile.languageDetail}</h3>
      </article>
    </div>
  </section>

  <section class="contact-section" id="contact">
    <div class="shell contact-inner">
      <p class="eyebrow">{content.contact.eyebrow}</p>
      <h2>{content.contact.title}</h2>
      <p>{content.contact.body}</p>
      <div class="button-row">
        <a class="button light" href="mailto:contact@tom-mendy.com">{content.contact.email}<span aria-hidden="true">↗</span></a>
        <a class="button ghost" href="https://linkedin.com/in/tom-mendy">{content.contact.linkedin}<span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</main>

<footer class="site-footer">
  <div class="shell footer-inner">
    <p>{content.footer}</p>
    <div><a href="mailto:contact@tom-mendy.com">contact@tom-mendy.com</a><a href="#content">{content.locale === 'fr' ? 'Haut de page ↑' : 'Back to top ↑'}</a></div>
  </div>
</footer>
