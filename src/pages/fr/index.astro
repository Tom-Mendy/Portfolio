---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortfolioPage from '../../components/PortfolioPage.astro';
import { portfolioContent } from '../../data/portfolio';
import { createProfilePageStructuredData } from '../../data/seo';
const content = portfolioContent.fr;
const structuredData = createProfilePageStructuredData('fr', content.meta.description);
---
<BaseLayout title={content.meta.title} description={content.meta.description} locale="fr" alternatePath="/en/" xDefaultPath="/" structuredData={structuredData}>
  <PortfolioPage content={content} />
</BaseLayout>
