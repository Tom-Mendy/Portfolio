---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Choisir une langue | Tom Mendy"
  description="Choisissez la langue du portfolio de Tom Mendy. Choose the language for Tom Mendy's portfolio."
  locale="fr"
  noindex
>
  <main id="content" class="error-page shell">
    <div class="error-card">
      <p class="error-code">Langue · Language</p>
      <h1>Choisir une langue.</h1>
      <p>Select the language you want to use.</p>
      <div class="button-row">
        <a class="button primary" href="/fr/" hreflang="fr">Français</a>
        <a class="button secondary" href="/en/" hreflang="en">English</a>
      </div>
    </div>
  </main>
</BaseLayout>
